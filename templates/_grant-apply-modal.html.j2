<!-- Grant application modal -->
<div class="modal-overlay" id="grantApplyModal">
  <div class="modal">
    <button class="modal-close" data-action="close-grant-apply" aria-label="Close grant application">✕</button>
    <h3 data-cs="form.grant_apply.heading">{{ sections["form.grant_apply"].heading }}</h3>
    <p class="sub" data-cs="form.grant_apply.sub">{{ sections["form.grant_apply"].sub }}</p>
    <form id="grantApplyForm" data-action="submit-grant-apply">
      <div class="field">
        <label for="grantName" data-cs="form.grant_apply.name_label">{{ sections["form.grant_apply"].name_label }}</label>
        <input id="grantName" type="text" placeholder="{{ sections['form.grant_apply'].name_placeholder }}" required>
      </div>
      <div class="field">
        <label for="grantEmail" data-cs="form.grant_apply.email_label">{{ sections["form.grant_apply"].email_label }}</label>
        <input id="grantEmail" type="email" placeholder="{{ sections['form.grant_apply'].email_placeholder }}" required>
      </div>
      <div class="field">
        <label for="grantRequestedFor" data-cs="form.grant_apply.requested_for_label">{{ sections["form.grant_apply"].requested_for_label }}</label>
        <input id="grantRequestedFor" type="text" placeholder="{{ sections['form.grant_apply'].requested_for_placeholder }}">
      </div>
      <p class="privacy-line" data-cs="form.grant_apply.privacy_line">{{ sections["form.grant_apply"].privacy_line }}</p>
      <button type="submit" class="btn btn-plum w-100" data-cs="form.grant_apply.submit_label">{{ sections["form.grant_apply"].submit_label }}</button>
      <div class="success-note" data-intake-success role="status" aria-live="polite">✓ Application received — staff will review it on your caregiver record.</div>
      <div class="error-note" data-intake-error role="alert" aria-live="assertive"></div>
      <div class="routing-note" data-intake-routing>Behind the scenes: a grant application was submitted and a grant-review follow-up is queued.</div>
    </form>
  </div>
</div>
