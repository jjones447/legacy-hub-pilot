<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Caregiver Sanctuary — Legacy Home &amp; Respite Care Foundation</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css">
</head>
<body>


{% set active_page = 'programs' %}
{% include '_header.html.j2' %}

<section class="hero py-56-64">
  <div class="container">
    <h1 class="hero-title-clamp" data-cs="programs.hero.title">{{ sections["programs.hero"].title }}</h1>
    <p class="lede" data-cs="programs.hero.lede">{{ sections["programs.hero"].lede }}</p>
    <div class="btn-row">
      <a href="#" class="btn btn-coral" data-action="open-membership" data-cs="programs.hero.cta_label">{{ sections["programs.hero"].cta_label }}</a>
    </div>
  </div>
</section>

<section id="membership">
  <div class="container">
    <div class="split">
      <div>
        <span class="eyebrow" data-cs="programs.membership.eyebrow">{{ sections["programs.membership"].eyebrow }}</span>
        <h2 class="mb-14" data-cs="programs.membership.heading">{{ sections["programs.membership"].heading }}</h2>
        <div data-cs-list="programs.membership.paragraphs" data-cs-item="p.muted.mb-16">
{%- for p in sections["programs.membership"].paragraphs %}
        <p class="muted mb-16">{{ p }}</p>
{%- endfor %}
        </div>
      </div>
      <div class="visual">
        <h3 class="fs-18-mb-14" data-cs="programs.membership.panel_heading">{{ sections["programs.membership"].panel_heading }}</h3>
{%- for r in sections["programs.membership"].rows %}
        <div class="kv-row"><span class="k">{{ r.k }}</span><span class="v">{{ r.v }}</span></div>
{%- endfor %}
      </div>
    </div>
  </div>
</section>

<section class="section-sand" id="support-group">
  <div class="container">
    <div class="split">
      <div class="visual bg-white">
        <h3 class="fs-18-mb-14" data-cs="programs.support_group.panel_heading">{{ sections["programs.support_group"].panel_heading }}</h3>
{%- for r in sections["programs.support_group"].rows %}
        <div class="kv-row"><span class="k">{{ r.k }}</span><span class="v">{{ r.v }}</span></div>
{%- endfor %}
        <a href="events.html" class="btn btn-plum btn-sm mt-16 d-inline-block" data-cs="programs.support_group.panel_cta_label">{{ sections["programs.support_group"].panel_cta_label }}</a>
      </div>
      <div>
        <span class="eyebrow" data-cs="programs.support_group.eyebrow">{{ sections["programs.support_group"].eyebrow }}</span>
        <h2 class="mb-14" data-cs="programs.support_group.heading">{{ sections["programs.support_group"].heading }}</h2>
        <div data-cs-list="programs.support_group.paragraphs" data-cs-item="p.muted.mb-16">
{%- for p in sections["programs.support_group"].paragraphs %}
        <p class="muted mb-16">{{ p }}</p>
{%- endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<section id="passport">
  <div class="container">
    <div class="split">
      <div>
        <span class="eyebrow">Program</span>
        <h2 class="mb-14">Caregiver Wellness Passport</h2>
        <p class="muted mb-16">A way for caregivers to engage in wellness activities, Legacy programs, community experiences, and participating Community Wellness Partner locations.</p>
        <p class="muted mb-16">Participation connects you to community wellness experiences and unlocks <strong>Wellness Grant eligibility as a benefit of participation</strong>.</p>
        <div class="btn-row mt-16-util">
          <a href="wellness-passport.html" class="btn btn-coral btn-sm">Explore the Wellness Passport</a>
          <a href="#" class="btn btn-plum btn-sm" data-action="open-grant-apply">Apply for a Wellness Grant</a>
        </div>
      </div>
      <div class="visual" id="grants">
        <h3 class="fs-18-mb-14">Passport &amp; Grant Journey</h3>
        <div class="timeline-item"><div class="timeline-dot bg-green"></div><div><strong>1 · Join Caregiver Sanctuary</strong><div class="when">Free membership — get your Passport</div></div></div>
        <div class="timeline-item"><div class="timeline-dot bg-green"></div><div><strong>2 · Engage in Wellness &amp; Programs</strong><div class="when">Activities, groups, and partner locations</div></div></div>
        <div class="timeline-item"><div class="timeline-dot bg-amber"></div><div><strong>3 · Wellness Grant Eligibility</strong><div class="when">Stipend benefit for personal wellness</div></div></div>
        <div class="timeline-item"><div class="timeline-dot section-sand"></div><div><strong>4 · Check-in &amp; Outcomes</strong><div class="when">We follow your journey, not just the award</div></div></div>
      </div>
    </div>
  </div>
</section>

<section class="section-sand" id="socials">
  <div class="container">
    <div class="split">
      <div class="visual bg-white">
        <h3 class="fs-18-mb-14" data-cs="programs.socials.panel_heading">{{ sections["programs.socials"].panel_heading }}</h3>
{%- for r in sections["programs.socials"].rows %}
        <div class="kv-row"><span class="k">{{ r.k }}</span><span class="v">{{ r.v }}</span></div>
{%- endfor %}
        <p class="small muted mt-16" data-cs="programs.socials.panel_note">{{ sections["programs.socials"].panel_note }}</p>
      </div>
      <div>
        <span class="eyebrow" data-cs="programs.socials.eyebrow">{{ sections["programs.socials"].eyebrow }}</span>
        <h2 class="mb-14" data-cs="programs.socials.heading">{{ sections["programs.socials"].heading }}</h2>
        <div data-cs-list="programs.socials.paragraphs" data-cs-item="p.muted.mb-16">
{%- for p in sections["programs.socials"].paragraphs %}
        <p class="muted mb-16">{{ p }}</p>
{%- endfor %}
        </div>
        <a href="events.html" class="btn btn-plum btn-sm" data-cs="programs.socials.cta_label">{{ sections["programs.socials"].cta_label }}</a>
      </div>
    </div>
  </div>
</section>

<section id="coaching">
  <div class="container">
    <div class="card flex-wrap-center-gap-24">
      <div class="icon m-0-flex-shrink-0">💬</div>
      <div class="flex-1-min-260">
        <span class="badge badge-blue" data-cs="programs.coaching.badge">{{ sections["programs.coaching"].badge }}</span>
        <h3 class="fs-20-m-8-0-6" data-cs="programs.coaching.heading">{{ sections["programs.coaching"].heading }}</h3>
        <p class="muted small m-0" data-cs="programs.coaching.body">{{ sections["programs.coaching"].body }}</p>
      </div>
      <a href="#" class="btn btn-outline btn-sm" data-action="open-coaching-interest" data-cs="programs.coaching.cta_label">{{ sections["programs.coaching"].cta_label }}</a>
    </div>
  </div>
</section>

{% include '_membership-modal.html.j2' %}
{% include '_grant-apply-modal.html.j2' %}
{% include '_coaching-interest-modal.html.j2' %}
{% include '_footer.html.j2' %}

<script src="app.js"></script>
<script src="nav-v2.js"></script>
</body>
</html>
