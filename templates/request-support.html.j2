<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Request Support — Legacy Home &amp; Respite Care Foundation</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css">
</head>
<body>


{% set active_page = 'request-support' %}
{% include '_header.html.j2' %}

<section class="hero py-56-64">
  <div class="container">
    <h1 class="hero-title-clamp" data-cs="request_support.hero.title">{{ sections["request_support.hero"].title }}</h1>
    <p class="lede" data-cs="request_support.hero.lede">{{ sections["request_support.hero"].lede }}</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="split align-start">
      <div class="login-card measure-none">
        <h2 class="fs-24" data-cs="form.request_support.heading">{{ sections["form.request_support"].heading }}</h2>
        <p class="sub" data-cs="form.request_support.sub">{{ sections["form.request_support"].sub }}</p>
        <form id="supportForm" data-action="submit-support">
          <div class="field">
            <label for="supName" data-cs="form.request_support.name_label">{{ sections["form.request_support"].name_label }}</label>
            <input id="supName" type="text" placeholder="{{ sections['form.request_support'].name_placeholder }}" required>
          </div>
          <div class="field">
            <label for="supEmail" data-cs="form.request_support.email_label">{{ sections["form.request_support"].email_label }}</label>
            <input id="supEmail" type="text" placeholder="{{ sections['form.request_support'].email_placeholder }}" required>
          </div>
          <div class="field">
            <label for="supWho" data-cs="form.request_support.who_label">{{ sections["form.request_support"].who_label }}</label>
            <select id="supWho" data-cs-options="form.request_support.who_options">
{%- for opt in sections["form.request_support"].who_options %}
              <option value="{{ opt }}">{{ opt }}</option>
{%- endfor %}
            </select>
          </div>
          <div class="field">
            <label for="supWhat" data-cs="form.request_support.what_label">{{ sections["form.request_support"].what_label }}</label>
            <select id="supWhat" data-cs-options="form.request_support.what_options">
{%- for opt in sections["form.request_support"].what_options %}
              <option value="{{ opt }}">{{ opt }}</option>
{%- endfor %}
            </select>
          </div>
          <div class="field">
            <label for="supMsg" data-cs="form.request_support.msg_label">{{ sections["form.request_support"].msg_label }}</label>
            <textarea id="supMsg" rows="4" placeholder="{{ sections['form.request_support'].msg_placeholder }}"></textarea>
          </div>
          <p class="privacy-line" data-cs="form.request_support.privacy_line">{{ sections["form.request_support"].privacy_line }}</p>
          <button type="submit" class="btn btn-coral w-100" data-cs="form.request_support.submit_label">{{ sections["form.request_support"].submit_label }}</button>
          <div class="success-note" id="supSuccess" data-intake-success role="status" aria-live="polite">✓ Request received — our team will reach out within two business days.</div>
          <div class="error-note" data-intake-error role="alert" aria-live="assertive"></div>
          <div class="routing-note" id="supRouting" data-intake-routing>Behind the scenes: this request created or updated a caregiver record and queued a follow-up for staff — nothing gets lost in an inbox.</div>
        </form>
      </div>
      <div>
        <span class="eyebrow" data-cs="request_support.next.eyebrow">{{ sections["request_support.next"].eyebrow }}</span>
        <h2 class="fs-26-mb-18" data-cs="request_support.next.heading">{{ sections["request_support.next"].heading }}</h2>
{%- for it in sections["request_support.next"].steps %}
        <div class="timeline-item"><div class="timeline-dot{% if it.dot == 'var(--green)' %} bg-green{% elif it.dot == 'var(--amber)' %} bg-amber{% elif it.dot %} section-sand{% endif %}"></div><div><strong>{{ it.title }}</strong><div class="when">{{ it.when }}</div></div></div>
{%- endfor %}
        <div class="card mt-24 card-sand-dashed">
          <p class="small m-0">{{ sections["request_support.next"].crisis_html }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% include '_footer.html.j2' %}

<script src="app.js"></script>
<script src="nav-v2.js"></script>
</body>
</html>
