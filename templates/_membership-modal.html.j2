<!-- Membership modal -->
<div class="modal-overlay" id="membershipModal">
  <div class="modal">
    <button class="modal-close" data-action="close-membership" aria-label="Close membership form">✕</button>
    <h3 data-cs="form.membership.heading">{{ sections["form.membership"].heading }}</h3>
    <p class="sub" data-cs="form.membership.sub">{{ sections["form.membership"].sub }}</p>
    <form id="membershipForm" data-action="submit-membership">
      <div class="field">
        <label for="memName" data-cs="form.membership.name_label">{{ sections["form.membership"].name_label }}</label>
        <input id="memName" type="text" placeholder="{{ sections['form.membership'].name_placeholder }}" required>
      </div>
      <div class="field">
        <label for="memEmail" data-cs="form.membership.email_label">{{ sections["form.membership"].email_label }}</label>
        <input id="memEmail" type="email" placeholder="{{ sections['form.membership'].email_placeholder }}" required>
      </div>
      <div class="field">
        <label for="memCaringFor" data-cs="form.membership.caring_for_label">{{ sections["form.membership"].caring_for_label }}</label>
        <select id="memCaringFor" data-cs-options="form.membership.caring_for_options">
{%- for opt in sections["form.membership"].caring_for_options %}
          <option value="{{ opt }}">{{ opt }}</option>
{%- endfor %}
        </select>
      </div>
      <div class="field">
        <label for="memNote" data-cs="form.membership.note_label">{{ sections["form.membership"].note_label }}</label>
        <textarea id="memNote" rows="3" placeholder="{{ sections['form.membership'].note_placeholder }}"></textarea>
      </div>
      <p class="privacy-line" data-cs="form.membership.privacy_line">{{ sections["form.membership"].privacy_line }}</p>
      <button type="submit" class="btn btn-coral w-100" data-cs="form.membership.submit_label">{{ sections["form.membership"].submit_label }}</button>
      <div class="success-note" data-intake-success role="status" aria-live="polite">✓ Membership request received — welcome to The Sanctuary.</div>
      <div class="error-note" data-intake-error role="alert" aria-live="assertive"></div>
      <div class="routing-note" data-intake-routing>Behind the scenes: your caregiver record was created or updated and staff follow-up is queued.</div>
    </form>
  </div>
</div>
