<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Legacy Home &amp; Respite Care Foundation — Caregiver Wellness &amp; Resource Hub</title>
<meta name="description" content="Supporting dementia caregivers through community, wellness, and respite.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css">
</head>
<body class="home-page">


{% set active_page = 'index' %}
{% include '_header.html.j2' %}

<section class="hero has-video">
  <video class="hero-video" autoplay muted loop playsinline preload="metadata"
         poster="media/hero-poster.jpg" aria-hidden="true" tabindex="-1">
    <source src="media/hero.webm" type="video/webm">
    <source src="media/hero.mp4" type="video/mp4">
  </video>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="container hero-content">
    <h1 data-cs="home.hero.title">{{ sections["home.hero"].title }}</h1>
    <p class="lede" data-cs="home.hero.lede">{{ sections["home.hero"].lede }}</p>
    <div class="btn-row">
      <a href="request-support.html" class="btn btn-coral">Find Support</a>
      <a href="donate.html" class="btn btn-outline-light">Donate</a>
    </div>
  </div>
</section>

<section class="home-journey">
  <div class="container">
    <div class="section-head">
      <h2 data-cs="home.journey.heading">{{ sections["home.journey"].heading }}</h2>
      <p data-cs="home.journey.paragraph">{{ sections["home.journey"].paragraph }}</p>
    </div>
  </div>
</section>

<section class="section-sand home-support">
  <div class="container">
    <div class="section-head">
      <h2 class="home-support-heading" data-cs="home.support.heading">{{ sections["home.support"].heading }}</h2>
    </div>
{% set support_navigation = {
      "Wellness": {"href": "wellness-passport.html", "description": "Connect with wellness activities, partner experiences, and grant benefits.", "label": "About the passport"},
      "Respite": {"href": "drop-in-respite.html", "description": "Time to breathe while your loved one is somewhere safe, engaged and cared for.", "label": "About Drop-In Respite"},
      "Community": {"href": "community-series.html", "description": "Gatherings and wellness sessions for caregivers across the community.", "label": "About the series"}
} %}
    <div class="card-grid">
{%- for tile in sections["home.support"].tiles %}
{% set destination = support_navigation.get(tile.title) %}
      <div class="card home-support-card">
        <h3>{{ tile.title | e }}</h3>
{% if destination %}
        <p>{{ destination.description | e }}</p>
        <a class="more" href="{{ destination.href }}">{{ destination.label }} <span aria-hidden="true">&rarr;</span></a>
{% endif %}
      </div>
{%- endfor %}
    </div>
    <p class="mt-32" data-cs="home.support.secondary">{{ sections["home.support"].secondary }}</p>
  </div>
</section>

{% with carousel_id="community", carousel_title="Moments from our community",
        carousel_blurb="Caregivers, families and volunteers at Legacy events.",
        carousel_images=gallery[:10],
        carousel_more_href="gallery.html" %}
{% include "_carousel.html.j2" %}
{% endwith %}

<section class="stats-band">
  <div class="container">
    <div class="section-head text-center mx-auto">
      <span class="eyebrow">Our impact</span>
      <h2>Together, we're making a difference.</h2>
    </div>
    <div class="stats-grid">
      <div class="stat"><div class="num">100+</div><div class="label">Family Caregivers Supported</div></div>
      <div class="stat"><div class="num">1500+</div><div class="label">Hours of Respite Care Provided</div></div>
      <div class="stat"><div class="num">40+</div><div class="label">Individuals Living with Dementia Supported</div></div>
      <div class="stat"><div class="num">100,000+</div><div class="label">People Reached Through Community Outreach</div></div>
    </div>
    <p class="small muted text-center"><em>Cumulative Impact Since Founding</em></p>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Caregiver voices</span>
      <h2>Stories from our community</h2>
    </div>
    <div class="quote-grid">
      <div class="quote-card">
        <blockquote>"Legacy reminded me that I mattered too."</blockquote>
      </div>
      <div class="quote-card">
        <blockquote>"Before Legacy, I felt completely alone. Now I have a community that understands what I'm going through."</blockquote>
      </div>
    </div>
    <p class="mt-32"><a href="programs.html" class="btn btn-outline">Read More Stories</a></p>
  </div>
</section>

<section class="section-sand">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Upcoming events</span>
      <h2>Join us in the community.</h2>
      <p>Whether it's a caregiver meetup, respite program, educational workshop, or wellness event, there's always an opportunity to connect.</p>
    </div>
{%- for ev in events if ev.teaser and (ev.schedule_confirmed | default(false)) %}
    <div class="card event-card{% if not loop.last %} mb-16{% endif %}">
      <div class="event-date"><div class="month">{{ ev.month | e }}</div><div class="day">{{ ev.day | e }}</div></div>
      <div>
        <span class="badge {{ ev.badge_class }}">{{ ev.badge | e }}</span>
        <h3 class="fs-18-m-8-0-4">{{ ev.title | e }}</h3>
        <div class="event-meta">{{ ev.meta | e }}</div>
        <a class="more" href="events.html">Register →</a>
      </div>
    </div>
{%- else %}
    <p class="muted">Schedule pending. Confirmed dates and registration details will appear on the Events page.</p>
{%- endfor %}
    <p class="mt-24"><a href="events.html" class="btn btn-outline">View Events</a></p>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-head"><span class="eyebrow">Our Partners</span>
      <h2>Building stronger communities together.</h2>
      <p>We're proud to work alongside healthcare organizations, businesses, foundations, and Community Wellness Partners who share our commitment to improving the lives of dementia caregivers and their families.</p>
    </div>
    <ul class="client-partner-logos" aria-label="Legacy partners">
      <li><a href="https://www.molinahealthcare.com/"><img src="media/client-oct16/partners/molina-healthcare.png" alt="Molina Healthcare" width="180" height="54" loading="lazy" decoding="async"></a></li>
      <li><a href="https://www.alz.org/"><img src="media/client-oct16/partners/alzheimers-association.svg" alt="Alzheimer's Association" width="714" height="135" loading="lazy" decoding="async"></a></li>
      <li><a href="https://www.wecenergygroup.com/community/we-energies-community.htm"><img src="media/client-oct16/partners/we-energies-foundation.jpg" alt="We Energies Foundation" width="255" height="77" loading="lazy" decoding="async"></a></li>
      <li><a href="https://www.packers.com/community/packers-foundation"><img src="media/client-oct16/partners/green-bay-packers-foundation.png" alt="Green Bay Packers Foundation" width="1280" height="720" loading="lazy" decoding="async"></a></li>
      <li><a href="https://wpp.med.wisc.edu/"><img src="media/client-oct16/partners/wisconsin-partnership-program.jpg" alt="Wisconsin Partnership Program, University of Wisconsin School of Medicine and Public Health" width="1280" height="548" loading="lazy" decoding="async"></a></li>
      <li><a href="https://www.nonprofitmanagementfund.org/"><img src="media/client-oct16/partners/nonprofit-management-fund.png" alt="Nonprofit Management Fund" width="1403" height="616" loading="lazy" decoding="async"></a></li>
      <li><a href="https://www.greatermilwaukeefoundation.org/"><img src="media/client-oct16/partners/greater-milwaukee-foundation.webp" alt="Greater Milwaukee Foundation" width="2478" height="739" loading="lazy" decoding="async"></a></li>
      <li><a href="https://bader.org/"><img src="media/client-oct16/partners/bader-philanthropies.png" alt="Bader Philanthropies" width="11433" height="3985" loading="lazy" decoding="async"></a></li>
      <li><a href="https://veridianhomes.com/about/veridian-foundation/"><img src="media/client-oct16/partners/veridian-foundation.png" alt="Veridian Foundation" width="3199" height="778" loading="lazy" decoding="async"></a></li>
    </ul>
  </div>
</section>

<section class="band-teal">
  <div class="container">
    <span class="eyebrow">Stay Connected</span>
    <h2 class="mb-12">Don't miss upcoming events, caregiver resources, and community updates.</h2>
    <p class="mb-28">Start your free Caregiver Sanctuary membership. This creates your caregiver record so Legacy can follow up about programs and support.</p>
    <a href="#" class="btn btn-coral" data-action="open-membership">Join the Caregiver Sanctuary</a>
  </div>
</section>

{% include '_membership-modal.html.j2' %}
<section class="section-sand" id="donate">
  <div class="container text-center">
    <span class="eyebrow">Donate</span>
    <h2 class="mb-14">Every caregiver deserves support.</h2>
    <p class="muted measure-560-center-mb-28">Your generosity helps provide respite, wellness opportunities, education, and meaningful community experiences for dementia caregivers and their loved ones. Together, we're creating communities where no caregiver has to navigate dementia alone.</p>
    <a href="https://givebutter.com/support-the-caregiver-sanctuary" class="btn btn-coral" target="_blank" rel="noopener">Make a Donation</a>
  </div>
</section>

{% include '_footer.html.j2' %}

<script src="app.js"></script>
<script src="nav-v2.js"></script>
</body>
</html>
