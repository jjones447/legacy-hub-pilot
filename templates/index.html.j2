<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Legacy Home &amp; Respite Care Foundation — Caregiver Wellness &amp; Resource Hub</title>
<meta name="description" content="Supporting dementia caregivers through community, wellness, and respite.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css">
</head>
<body>


{% set active_page = 'index' %}
{% include '_header.html.j2' %}

<section class="hero has-video">
  <video class="hero-video" autoplay muted loop playsinline preload="metadata"
         poster="media/hero-poster.jpg" aria-hidden="true" tabindex="-1">
    <source src="media/hero.webm" type="video/webm">
    <source src="media/hero.mp4" type="video/mp4">
  </video>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="container hero-content">
    <h1>{{ sections["home.hero"].title }}</h1>
    <p class="lede">{{ sections["home.hero"].lede }}</p>
    <div class="btn-row">
      <a href="request-support.html" class="btn btn-coral">Find Support</a>
      <a href="donate.html" class="btn btn-outline-light">Donate</a>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-head">
      <h2>{{ sections["home.journey"].heading }}</h2>
      <p>{{ sections["home.journey"].paragraph }}</p>
    </div>
  </div>
</section>

<section class="section-sand">
  <div class="container">
    <div class="section-head">
      <h2>{{ sections["home.support"].heading }}</h2>
    </div>
    <div class="card-grid">
{%- for tile in sections["home.support"].tiles %}
      <div class="card">
        <h3>{{ tile.title }}</h3>
      </div>
{%- endfor %}
    </div>
    <p class="mt-32">{{ sections["home.support"].secondary }}</p>
  </div>
</section>

{% with carousel_id="community", carousel_title="Moments from our community",
        carousel_blurb="Caregivers, families and volunteers at Legacy events.",
        carousel_images=gallery[:10],
        carousel_more_href="gallery.html" %}
{% include "_carousel.html.j2" %}
{% endwith %}

<section class="band-teal">
  <div class="container">
    <span class="eyebrow">{{ sections["home.community_wellness_partners"].eyebrow }}</span>
    <h2 class="mb-14">{{ sections["home.community_wellness_partners"].heading }}</h2>
    <p class="mb-28">{{ sections["home.community_wellness_partners"].paragraph }}</p>
    <a href="{{ sections["home.community_wellness_partners"].cta_href }}" class="btn btn-coral">{{ sections["home.community_wellness_partners"].cta_label }}</a>
  </div>
</section>

<section class="stats-band">
  <div class="container">
    <div class="section-head text-center mx-auto">
      <span class="eyebrow">Our impact</span>
      <h2>Together, we're making a difference.</h2>
    </div>
    <div class="stats-grid">
      <div class="stat"><div class="num">70+</div><div class="label">Family Caregivers Supported</div></div>
      <div class="stat"><div class="num">1,000+</div><div class="label">Hours of Respite Provided</div></div>
      <div class="stat"><div class="num">100,000+</div><div class="label">Community Members Reached Through Outreach</div></div>
      <div class="stat"><div class="num">30</div><div class="label">Individuals Living with Dementia</div></div>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Caregiver voices</span>
      <h2>Stories from our community</h2>
    </div>
    <div class="quote-grid">
      <div class="quote-card">
        <blockquote>"Legacy reminded me that I mattered too."</blockquote>
      </div>
      <div class="quote-card">
        <blockquote>"Before Legacy, I felt completely alone. Now I have a community that understands what I'm going through."</blockquote>
      </div>
    </div>
    <p class="mt-32"><a href="programs.html" class="btn btn-outline">Read More Stories</a></p>
  </div>
</section>

<section class="section-sand">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Upcoming events</span>
      <h2>Join us in the community.</h2>
      <p>Whether it's a caregiver meetup, respite program, educational workshop, or wellness event, there's always an opportunity to connect.</p>
    </div>
{%- for ev in events if ev.teaser %}
    <div class="card event-card{% if not loop.last %} mb-16{% endif %}">
      <div class="event-date"><div class="month">{{ ev.month | e }}</div><div class="day">{{ ev.day | e }}</div></div>
      <div>
        <span class="badge {{ ev.badge_class }}">{{ ev.badge | e }}</span>
        <h3 class="fs-18-m-8-0-4">{{ ev.title | e }}</h3>
        <div class="event-meta">{{ ev.meta | e }}</div>
        <a class="more" href="events.html">Register →</a>
      </div>
    </div>
{%- endfor %}
    <p class="mt-24"><a href="events.html" class="btn btn-outline">View Events</a></p>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-head"><span class="eyebrow">Our Partners</span>
      <h2>Building stronger communities together.</h2>
      <p>We're proud to work alongside healthcare organizations, businesses, foundations, and Community Wellness Partners who share our commitment to improving the lives of dementia caregivers and their families.</p>
    </div>
    <p class="muted measure-560"><em>Partner logos will be featured here as partnerships are confirmed.</em></p>
  </div>
</section>

<section class="band-teal">
  <div class="container">
    <span class="eyebrow">Stay Connected</span>
    <h2 class="mb-12">Don't miss upcoming events, caregiver resources, and community updates.</h2>
    <p class="mb-28">Join our email list to receive the latest news, upcoming programs, caregiver resources, and opportunities to connect with our community.</p>
    <a href="#" class="btn btn-coral" data-action="open-membership">Stay Connected</a>
  </div>
</section>

{% include '_membership-modal.html.j2' %}
<section class="section-sand" id="donate">
  <div class="container text-center">
    <span class="eyebrow">Donate</span>
    <h2 class="mb-14">Every caregiver deserves support.</h2>
    <p class="muted measure-560-center-mb-28">Your generosity helps provide respite, wellness opportunities, education, and meaningful community experiences for dementia caregivers and their loved ones. Together, we're creating communities where no caregiver has to navigate dementia alone.</p>
    <a href="https://givebutter.com/support-the-caregiver-sanctuary" class="btn btn-coral" target="_blank" rel="noopener">Make a Donation</a>
  </div>
</section>

{% include '_footer.html.j2' %}

<script src="app.js"></script>
<script src="nav-v2.js"></script>
</body>
</html>
